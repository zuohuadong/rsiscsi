# Copy to .env.release and fill in. The file is git-ignored.
WEBDAV_URL=https://dav.ctfile.com/ws00000
WEBDAV_USERNAME=you@example.com
WEBDAV_PASSWORD=
# Upload root; "/" puts 软件集合 at the drive root.
WEBDAV_ROOT_PATH=/
# Folder below the root; a leading / ignores WEBDAV_ROOT_PATH.
SOFTWARE_COLLECTION_DIR=软件集合/rsiscsi
